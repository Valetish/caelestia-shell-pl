# Maintainer: Valetish

pkgname=caelestia-shell-pl
pkgver=0.9
pkgrel=1
pkgdesc='Caelestia Shell with the complete Polish interface translation'
arch=('x86_64' 'aarch64')
url='https://github.com/Valetish/caelestia-shell-pl'
license=('GPL-3.0-only')
depends=(
    'caelestia-cli'
    'quickshell-git'
    'glibc'
    'gcc-libs'

    # Brightness
    'ddcutil'
    'brightnessctl'

    # Services
    'libcava'
    'networkmanager'
    'lm_sensors'
    'aubio'
    'libpipewire'
    'libqalculate'
    'power-profiles-daemon'

    # Fonts
    'ttf-material-symbols-variable'
    'ttf-rubik-vf'
    'ttf-cascadia-code-nerd'

    # Qt modules
    'qt6-base'
    'qt6-declarative'
    'qt6-imageformats'
    'qt6-m3shapes-git'

    # Extra functionality
    'swappy'
    'fish'
    'bash'
)
optdepends=(
    'asdbctl: controlling the brightness of Apple Studio Displays'
    'fprintd: fingerprint unlock for the lock screen'
    'howdy-next: face unlock for the lock screen'
)
makedepends=('cmake' 'git' 'ninja' 'qt6-shadertools')
provides=('caelestia-shell=2.5.0')
conflicts=('caelestia-shell' 'caelestia-shell-git')
source=("${pkgname}::git+${url}.git#tag=polish-v${pkgver}")
sha256sums=('SKIP')

build() {
    cd "${srcdir}/${pkgname}"

    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_INSTALL_PREFIX=/ \
        -DVERSION=2.5.0 \
        -DGIT_REVISION="$(git rev-parse HEAD)" \
        -DDISTRIBUTOR="GitHub (package: ${pkgname})"
    cmake --build build
}

package() {
    cd "${srcdir}/${pkgname}"

    DESTDIR="${pkgdir}" cmake --install build
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
